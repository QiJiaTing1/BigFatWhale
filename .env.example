# 复制此文件为 .env，然后填你自己的值。改完要重启后端才生效。
# 说明：只有「必填」三项是跑起来必须的，其余留注释即用默认值。

# ========== 必填：模型服务（OpenAI 兼容接口，DeepSeek 官方 API，换厂商只改这三行）==========
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# ========== 可选：模型调用参数 ==========
# AI_TEMPERATURE=0.95      # 越高越发散不套路，低了会一本正经（0~2）
# AI_TIMEOUT=90            # 单次请求超时秒数
# AI_MAX_RETRIES=3         # 限流/5xx 的自动重试次数

# ========== 可选：计价（元 / 百万 tokens，用于用量统计）==========
# PRICE_IN=1.0
# PRICE_OUT=2.0
# PRICE_CACHE=0.02

# ========== 可选：余额预警 ==========
# BALANCE_ALERT_YUAN=2.0   # 账户余额低于这个数（元）时，回复里撒娇/嘴硬讨充值

# ========== 可选：短期上下文 ==========
# HISTORY_MAX=20           # 每群内存缓存多少条
# HISTORY_USE=8            # 回复时带最近几条（必须 <= HISTORY_MAX）
# MAX_LEN_PER_MSG=120      # 单条消息截断字数
# AT_WINDOW=20             # 被 @ 后多少秒内补图也算发给它

# ========== 可选：长期记忆 ==========
# MEM_CONSOLIDATE_EVERY=10 # 攒够多少条触发一次合并（默认 10）
# MEM_ARCHIVE_MAX_CHARS=800
# MEM_PENDING_KEEP=200

# ========== 可选：情感记忆（情绪/关系） ==========
# EMO_HALF_LIFE_DAYS=3      # 情绪半衰期（天）：越强烈忘得越慢
# EMO_MIN_INTENSITY=0.15    # 衰减到低于这个强度就自动遗忘
# EMO_MAX_DAYS=30           # 情绪条目最长保留天数（兜底）
# EMO_MAX_CHARS=600         # 情感档案注入 prompt 的字数上限

# ========== 可选：服务监听（要和 NapCat 里填的反向 WS 地址对得上）==========
# HOST=127.0.0.1
# PORT=8080

# ========== 可选：人设 / 回复记录 ==========
# BOT_NICKNAME=鲸鱼娘
# 主人 QQ：私聊 + 群里这个人说话都走「女仆模式」，回话喊「主人」（留空 = 不启用）
# MASTER_QQ=
# REPLY_LOG_MAX_BYTES=5242880   # 回复日志滚动阈值（字节）

# ========== 可选：回复怎么发 ==========
# 带换行的回复按行拆成多条发（像真人打字分两条，人设里「祝福语正经一句+皮一句」就靠这个落地）
# REPLY_SPLIT_LINES=true
# REPLY_LINE_GAP=0.6            # 两条之间停几秒
# REPLY_MENTION=false           # 回复要不要 @ 对方；默认 false（群里聊天不带 @ 更像真人）

# ========== 可选：掉线守护 ==========
# QQ 登录失效掉线时，自动 docker restart napcat 尝试快速重登，失败则 Server 酱微信告警
# SERVERCHAN_SENDKEY=           # Server 酱 SendKey（sct.ftqq.com），留空 = 只重启不告警
# OFFLINE_AUTO_RESTART=true     # 掉线后是否自动重启 NapCat 容器（true/false）
# NAPCHAT_WEBUI_URL=            # NapCat WebUI 地址（告警里的扫码入口，留空就不带扫码链接）
# NAPCHAT_WEBUI_TOKEN=          # NapCat WebUI 登录 token

# ========== 必填（想用定时任务的话）：推送群号 ==========
# 课表本身在 timetable.json 里改，不用碰代码
TARGET_GROUP=
# REMIND_BEFORE=20         # 课前提前多少分钟提醒

# ========== 可选：主动发消息（主人私聊偶尔主动关心/闲聊一句） ==========
# 两段式：先过确定性闸门（开关/对象/静默时段/当日条数/减速窗口/随机中签），命中才调模型
# PROACTIVE_ENABLED=false      # 是否开启主动发消息（true/false）
# PROACTIVE_QUIET_START=23     # 静默开始小时（含）：23:00 之后不发
# PROACTIVE_QUIET_END=9        # 静默结束小时（不含）：9:00 之前不发
# PROACTIVE_MAX_PER_DAY=2      # 每天最多主动发几条
# PROACTIVE_TICK_MINUTES=45    # 每隔几分钟检查一次
# PROACTIVE_HIT_RATE=0.3       # 每次检查命中概率（0~1）
# PROACTIVE_COOLDOWN_HOURS=6   # 主人最近几小时内回过话就跳过（有回应就少打扰）

# ========== 可选：群白名单（留空 = 不限制）==========
# ALLOW_GROUPS=<群号1>,<群号2>

# ========== 可选：文字转语音（TTS）==========
# TTS_ENABLED=false          # 是否开启语音回复（true/false）
# TTS_ENGINE=edge            # 引擎：edge（免费，默认）| sovits（GPT-SoVITS 角色音色）
# TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# TTS_SOVITS_URL=http://127.0.0.1:9880   # GPT-SoVITS API 地址（跑在带 GPU 的机器上）
# TTS_SOVITS_REF_AUDIO=       # 参考音频路径（相对仓库根或绝对路径）
# TTS_SOVITS_PROMPT_TEXT=     # 参考音频对应的文字
# TTS_SOVITS_PROMPT_LANG=zh   # 参考音频语言

# ========== 可选：RVC 变声（把底音转成角色音色，如派蒙；跑在带 GPU 的机器上）==========
# TTS_RVC_ENABLED=false       # 开启后底音会再送 RVC 变声
# TTS_RVC_URL=http://127.0.0.1:6242   # RVC WebUI 的 api 地址（默认端口 6242）
# TTS_RVC_PTH=派蒙.pth        # RVC 模型权重路径（RVC 机器上的路径）
# TTS_RVC_INDEX=              # 索引文件路径（可选，留空 = 纯模型推理）
# TTS_RVC_PITCH=0             # 音高偏移（-24 ~ 24，0 = 不变）
# TTS_RVC_FORMANT=0.0         # 共振峰微调（-2.0 ~ 2.0）
# TTS_RVC_INDEX_RATE=0.75     # 索引混合比例（0 = 只用模型，1 = 全用索引）
# TTS_RVC_F0=rmvpe            # 音高提取算法：rmvpe | harvest | pm | crepe
